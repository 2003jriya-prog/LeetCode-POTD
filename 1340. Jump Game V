1340. Jump Game V


int solve(vector<int> &arr,int d,int n,int i,vector<int> &dp){
        int ans=1;
        if(dp[i]!=-1) return dp[i];
        //left
        for(int j=i-1;j>=max(0,i-d);j--){
            if(arr[j]>=arr[i]) break;
            ans=max(ans,1+solve(arr,d,n,j,dp));
        }
        
        //right
        for(int j=i+1;j<=min(n-1,i+d);j++){
            if(arr[j]>=arr[i]) break;
            ans=max(ans,1+solve(arr,d,n,j,dp));
        }
        return dp[i]=ans;
    }
    int maxJumps(vector<int>& arr, int d) {
        int n=arr.size();
        int ans=1;
        vector<int> dp(n,-1);
        for(int i=0;i<n;i++){
            ans=max(ans,solve(arr,d,n,i,dp));
        }
        return ans;
    }
