1345. Jump Game IV

 int minJumps(vector<int>& arr) {
        int n=arr.size();
        unordered_map<int,vector<int>> mp;
        for(int i=0;i<n;i++){
            mp[arr[i]].push_back(i);
        }
        queue<int> q;
        vector<int> vis(n,0);
        vis[0]=1;
        q.push(0);
        int ans=0;
        while(!q.empty()){
            int m=q.size();
            for(int i=0;i<m;i++){
            int x=q.front();
            q.pop();
            if(x==n-1) return ans;
            int left=x-1;
            if(left>=0 && vis[left]==0){
                vis[left]=1;
                q.push(left);
            }
            int right=x+1;
            if(right<n && vis[right]==0){
                vis[right]=1;
                q.push(right);
            }
            for(auto it : mp[arr[x]]){
                if(it!=x && vis[it]==0){
                     vis[it]=1;
                     q.push(it);
                }
            }
             mp[arr[x]].clear(); 
        }
        ans++;
        }
        return -1;
    }
