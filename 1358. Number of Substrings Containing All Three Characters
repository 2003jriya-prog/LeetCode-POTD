1358. Number of Substrings Containing All Three Characters

 int numberOfSubstrings(string s) {
        int n=s.length();
        unordered_map<char,int> mp;
        int i=0,j=0;
        int ans=0;
        while(j<n){
            mp[s[j]]++;
            while(mp['a']>0 && mp['b']>0 && mp['c']>0){
                ans+=(n-j);
                mp[s[i]]--;
                i++;
            }
            j++;
        }
        return ans;
    }
