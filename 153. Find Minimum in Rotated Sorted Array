153. Find Minimum in Rotated Sorted Array 


int findMin(vector<int>& nums) {
        int n=nums.size();
        if(n==1) return nums[0];
        int i=0,j=n-1;
        while(j>i){
            int mid=(i+j)/2;
            if(nums[mid]<nums[j]){
                j=mid;
            }
            else{
                i=mid+1;
            }
        }
        return nums[j];
    }
