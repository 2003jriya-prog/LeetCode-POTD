1833. Maximum Ice Cream Bars



 int maxIceCream(vector<int>& costs, int coins) {
        vector<int> freq(100001,0);
        for(int i=0;i<costs.size();i++){
            freq[costs[i]]++;
        }
        int ans=0;
        for(int i=1;i<100001;i++){
            if (freq[i] == 0) continue;
            if(coins<i) break;
            int canBuy=min(freq[i],(coins/i));
            ans+=canBuy;
            coins-=canBuy*i;
        }
        return ans;
    }
