--1861. Rotating the Box


vector<vector<char>> rotateTheBox(vector<vector<char>>& boxGrid) {
        int n=boxGrid.size();
        int m=boxGrid[0].size();
        vector<vector<char>> res(m,vector<char> (n));
        for(int i=0;i<m;i++){
            for(int j=0;j<n;j++){
                res[i][j]=boxGrid[n-1-j][i];
            }
        }
        for(int i=0;i<n;i++){
           int empty=m-1;
           for(int j=m-1;j>=0;j--){
            if(res[j][i]=='*'){
                empty=j-1;
            }
            else if(res[j][i]=='#'){
              swap(res[j][i],res[empty][i]);
                empty--;
            }
                
           } 
        }
        return res;
    }
