1914. Cyclically Rotating a Grid

vector<vector<int>> rotateGrid(vector<vector<int>>& grid, int k) {
        int m=grid.size();
        int n=grid[0].size();
        int l=min(m,n)/2;
        for(int i=0;i<l;i++){
            int top=i,right=n-i-1,bottom=m-i-1,left=i;
            vector<int> v;
            //top
            for(int j=left;j<=right;j++){
               v.push_back(grid[top][j]);
            }
            //right
            for(int j=top+1;j<=bottom-1;j++){
               v.push_back(grid[j][right]);
            }
            //bottom
            for(int j=right;j>=left;j--){
               v.push_back(grid[bottom][j]);
            }
            //left
            for(int j=bottom-1;j>=top+1;j--){
                v.push_back(grid[j][left]);
            }
            int sz=v.size();
            int start=k%sz;
            int idx=start;
            //top
            for(int j=left;j<=right;j++){
               grid[top][j]=v[idx++];
               if(idx==sz) idx=0;
            }
            //right
            for(int j=top+1;j<=bottom-1;j++){
               grid[j][right]=v[idx++];
               if(idx==sz) idx=0;
            }
            //bottom
            for(int j=right;j>=left;j--){
               grid[bottom][j]=v[idx++];
               if(idx==sz) idx=0;
            }
            //left
            for(int j=bottom-1;j>=top+1;j--){
                grid[j][left]=v[idx++];
                if(idx==sz) idx=0;
            }
        }
        return grid;
    }
