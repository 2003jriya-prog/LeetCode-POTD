2130. Maximum Twin Sum of a Linked List

int pairSum(ListNode* head) {
        vector<int> v;
        ListNode* temp= head;
        while(temp){
            v.push_back(temp->val);
            temp=temp->next;
        }
        int n=v.size();
        int i=0,j=n-1;
        int ans=INT_MIN;
        while(i<=j){
            ans=max(ans,v[i]+v[j]);
            i++;
            j--;
        }
        return ans;
    }
