2144. Minimum Cost of Buying Candies With Discount

int minimumCost(vector<int>& cost) {
        int n=cost.size();
        sort(cost.begin(),cost.end());
        int i=0,j=n-1;
        int ans=0;
        for(int i=n-1;i>=0;i--){
          if(i-2>=0){
            ans+=(cost[i]+cost[i-1]);
            i=i-2;
          }
          else{
            ans+=cost[i];
          }
        }
        return ans;
    }
