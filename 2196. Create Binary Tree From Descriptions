2196. Create Binary Tree From Descriptions

TreeNode* createBinaryTree(vector<vector<int>>& d) {
        int n=d.size();
        unordered_map<int,TreeNode*> mp;
        unordered_map<int,int> mpCh;
        for(int i=0;i<n;i++){
            int p=d[i][0];
            int c=d[i][1];
            int isLeft=d[i][2];
            TreeNode* par;
            if(mp.find(p)==mp.end()){
                par=new TreeNode(p);
                mp[p]=par;
            }
            else par=mp[p];
            TreeNode* child;
            if(mp.find(c)==mp.end()){
                child=new TreeNode(c);
                mp[c]=child;
            }
            else child=mp[c];
            if(isLeft==1){
                par->left=child;
            }
            else{
                par->right=child;
            }
            mpCh[c]++;
        }
        TreeNode* root;
        for(int i=0;i<n;i++){
            if(mpCh.find(d[i][0])==mpCh.end()){
                root=mp[d[i][0]];
                break;
            }
        }
        return root;
    }
