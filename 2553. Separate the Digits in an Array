2553. Separate the Digits in an Array

vector<int> separateDigits(vector<int>& nums) {
        int n=nums.size();
        vector<int> ans;
        for(int i=0;i<n;i++){
            int x=nums[i];
            vector<int> v;
            while(x){
                int rem=x%10;
                v.push_back(rem);
                x/=10;
            }
            for(int i=v.size()-1;i>=0;i--){
                ans.push_back(v[i]);
            }
        }
        return ans;
    }
