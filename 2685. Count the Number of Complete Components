2685. Count the Number of Complete Components


class Solution {
public:
    void dfs(int i, vector<vector<int>> &adj, vector<int> &vis,int &x,int &y){
        vis[i]=1;
        x++;
        y+=adj[i].size();
        for(auto it : adj[i]){
              if(!vis[it]){
                dfs(it,adj,vis,x,y);
              }
        }
    }
    int countCompleteComponents(int n, vector<vector<int>>& edges) {
        vector<vector<int>> adj(n);
        for(auto it : edges){
            adj[it[0]].push_back(it[1]);
            adj[it[1]].push_back(it[0]);
        }
        vector<int> vis(n,0);
        int ans=0;
        for(int i=0;i<n;i++){
            if(!vis[i]){
                int x=0,y=0;
                dfs(i,adj,vis,x,y);
                if(x*(x-1)==y) ans++;
            }
        }
        return ans;
    }
};
