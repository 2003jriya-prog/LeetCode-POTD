2770. Maximum Number of Jumps to Reach the Last Index----


(Tabulation) - 
int maximumJumps(vector<int>& nums, int target) {
       int n = nums.size();
        vector<int> dp(n, -1);
        dp[0] = 0;

        for(int i = 0; i < n; i++) {
            if(dp[i] == -1) continue;
            for(int j = i + 1; j < n; j++) {
                int diff = abs(nums[j] - nums[i]);
                if(diff <= target) {
                    dp[j] = max(dp[j], dp[i] + 1);
                }
            }
        }

        return dp[n - 1];
    }

(momization) - 
int solve(vector<int>& nums, int i, int n, int t, vector<int>& dp) {
        if (i == n - 1)
            return 0;
        int ans = -1e9;
        if (dp[i] != -1)
            return dp[i];
        for (int j = i + 1; j < n; j++) {
            int x = abs(nums[i] - nums[j]);
            if (x <= t) {
                int nxt = solve(nums, j, n, t, dp);
                if (nxt != -1e9) {
                    ans = max(ans, 1 + nxt);
                }
            }
        }
        return dp[i] = ans;
    }
    int maximumJumps(vector<int>& nums, int target) {
        int n = nums.size();
        vector<int> dp(n, -1);
        int ans = solve(nums, 0, n, target, dp);
        if (ans < 0)
            return -1;
        return ans;
    }
