3020. Find the Maximum Number of Elements in Subset -- 

 int maximumLength(vector<int>& nums) {
        int n=nums.size();
        map<long long,int> mp;
        for(auto it : nums){
            mp[it]++;
        }
        int ans=0;
        for(auto [el,freq] : mp){
            long long x=el;
            int cnt=0;
            while(mp.find(x)!=mp.end() && mp[x]){
                if(x==1) cnt+=mp[1];
                else if(mp[x]>=2) cnt+=2;
                else if(mp[x]==1){ cnt+=1; break;}
                mp[x]=0;
                if(x>1e5) break;
                x=x*x;
            }
            ans=max(ans,cnt-(cnt%2==0));
        }
        return ans;
    }
