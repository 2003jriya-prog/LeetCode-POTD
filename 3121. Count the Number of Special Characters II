3121. Count the Number of Special Characters II


  int numberOfSpecialChars(string word) {
        vector<int> l(26,-1);
        vector<int> u(26,-1);
        int n=word.size();
        for(int i=0;i<n;i++){
            char ch=word[i];
            if(islower(ch)){
                l[ch-'a']=i;
            }
            else{
                if(u[ch-'A']==-1){
                    u[ch-'A']=i;
                }
            }
        }
        int ans=0;
        for(int i=0;i<26;i++){
            if(l[i]!=-1 && u[i]!=-1 && l[i]<u[i]) ans++;
        }
        return ans;
    }
