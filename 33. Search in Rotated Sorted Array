33. Search in Rotated Sorted Array

int search(vector<int>& nums, int target) {
        int n=nums.size();
        int l=0,h=n-1;
        while(l<=h){
            int mid=(l+h)/2;
            if(nums[mid]==target) return mid;
            if(nums[h]>=nums[mid]){
                if(nums[mid]<=target && target<=nums[h]) l=mid+1;
                else h=mid-1;
            }
            else{
               if(nums[mid]>=target && target>=nums[l]) h=mid-1;
                else l=mid+1;
            }
        }
        return -1;
    }
