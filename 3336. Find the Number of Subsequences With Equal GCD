3336. Find the Number of Subsequences With Equal GCD


class Solution {
public:
    int dp[201][201][201];
    const int mod=1e9+7;
    int solve(vector<int> &nums,int i,int j,int idx,int n){
       if(idx>=n){
        if(i!=0 && i==j) return 1;
        return 0;
       }
       if(dp[i][j][idx]!=-1) return dp[i][j][idx];
       int ans=solve(nums,i,j,idx+1,n)%mod;
       int g1=(i!=0)? gcd(i,nums[idx]) : nums[idx];
       ans=(ans+solve(nums,g1,j,idx+1,n))%mod;
       int g2=(j!=0)? gcd(j,nums[idx]) : nums[idx];
       ans=(ans+solve(nums,i,g2,idx+1,n))%mod;
       return dp[i][j][idx]=ans;
    }
    int subsequencePairCount(vector<int>& nums) {
        int n=nums.size();
        memset(dp,-1,sizeof(dp));
        return solve(nums,0,0,0,n);
    }
};
