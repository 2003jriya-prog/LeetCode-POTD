3612. Process String with Special Operations I



string processStr(string s) {
        int n=s.length();
        string ans="";
        for(int i=0;i<n;i++){
            if(s[i]>='a' && s[i]<='z'){
                ans.push_back(s[i]);
            }
            else if(s[i]=='#'){
                ans+=ans;
            }
            else if(!ans.empty() && s[i]=='*'){
                ans.pop_back();
            }
            else if(s[i]=='%'){
                reverse(ans.begin(),ans.end());
            }
        }
        return ans;
    }
