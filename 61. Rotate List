61. Rotate List ---- 


ListNode* rotateRight(ListNode* head, int k) {
        if (!head || !head->next) return head;
        ListNode* tail = head;
        int n = 1;
        while (tail->next) {
            tail = tail->next;
            ++n;
        }
        k %= n;
        if (k == 0) return head;
        tail->next = head;
        ListNode* newTail = head;
        for (int i = 0; i < n - k - 1; ++i) {
            newTail = newTail->next;
        }

        ListNode* newHead = newTail->next;
        newTail->next = nullptr; 
        return newHead;
    }


TC - O(n)
SC - O(1)
